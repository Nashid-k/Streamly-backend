# Server-only values. In production, set these as your backend service's
# encrypted environment variables; do not commit a backend/.env file.
TMDB_READ_TOKEN=replace_with_a_tmdb_v4_read_access_token
# Or use a v3 API key instead of the read token:
# TMDB_API_KEY=replace_with_a_tmdb_v3_api_key

# Comma-separated frontend origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=en-US
# TMDB_REGION=IN
TMDB_CATALOG_PAGES=3
TMDB_ITEMS_PER_RAIL=24
TMDB_REQUEST_TIMEOUT_MS=6000
# Retry TMDB after this delay when startup loading failed.
TMDB_REFRESH_RETRY_MS=15000
DEFAULT_USER_NAME=Guest
# Local demo-state file. Use a database-backed user service for multi-instance production deployments.
# USER_STATE_FILE=/var/lib/nflix/user.json
# Set these only when demo mode is appropriate; production should use authenticated users.
# DEFAULT_USER_ID=
# DEFAULT_USER_EMAIL=
# DEFAULT_PROFILE_ID=
# DEFAULT_PROFILE_NAME=
# DEFAULT_PROFILE_AVATAR_URL=
